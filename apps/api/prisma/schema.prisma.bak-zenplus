generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "crm", "iam", "inventory"]
}

// ============================================
// SECCIÓN 1 · CRM
// ============================================

model Lead {
  id             String     @id @default(cuid())
  source         LeadSource
  status         LeadStatus @default(NEW)
  fullName       String
  email          String?
  phone          String?
  message        String?
  assetId        String?
  partyId        String?
  assignedTo     String?
  slaDueAt       DateTime?
  firstContactAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  qualifiedAt    DateTime?

  activities  Activity[]
  party       Party?       @relation(fields: [partyId], references: [id])
  opportunity Opportunity?

  @@index([status])
  @@index([assignedTo])
  @@index([email])
  @@index([phone])
  @@map("zenplus_lead")
  @@schema("crm")
}

model Activity {
  id        String       @id @default(cuid())
  leadId    String
  type      ActivityType
  outcome   String?
  notes     String?
  createdBy String
  createdAt DateTime     @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("zenplus_activity")
  @@schema("crm")
}

model Party {
  id        String    @id @default(cuid())
  type      PartyType
  email     String?   @unique
  phone     String?
  fullName  String?
  company   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  leads Lead[]

  @@map("zenplus_party")
  @@schema("crm")
}

model Opportunity {
  id           String           @id @default(cuid())
  leadId       String           @unique
  stage        OpportunityStage @default(NEW)
  amount       Decimal?
  currency     String           @default("PEN")
  nextAction   String?
  nextActionAt DateTime?
  closedAt     DateTime?
  closeReason  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lead           Lead                       @relation(fields: [leadId], references: [id])
  requirements   Requirement[]
  visits         Visit[]
  assetInterests OpportunityAssetInterest[]
  offerThreads   OfferThread[]
  reservations   Reservation[]

  @@index([stage])
  @@map("zenplus_opportunity")
  @@schema("crm")
}

model Requirement {
  id            String   @id @default(cuid())
  opportunityId String   @unique @map("opportunity_id")
  operationType String   @map("operation_type") @db.VarChar(20)
  assetType     String   @map("asset_type") @db.VarChar(30)
  zones         String[] @default([])
  budgetMin     Decimal? @map("budget_min") @db.Decimal(12, 2)
  budgetMax     Decimal? @map("budget_max") @db.Decimal(12, 2)
  currency      String   @default("USD") @db.VarChar(3)
  areaMin       Decimal? @map("area_min") @db.Decimal(10, 2)
  areaMax       Decimal? @map("area_max") @db.Decimal(10, 2)
  attributes    Json?
  timeHorizon   String?  @map("time_horizon") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("zenplus_requirement")
  @@schema("crm")
}

model Visit {
  id               String    @id @default(cuid())
  opportunityId    String    @map("opportunity_id")
  assetId          String    @map("asset_id")
  scheduledAt      DateTime  @map("scheduled_at")
  status           String    @default("SCHEDULED") @db.VarChar(20)
  notes            String?
  createdBy        String    @map("created_by")
  rescheduleReason String?   @map("reschedule_reason")
  rescheduledCount Int       @default(0) @map("rescheduled_count")
  cancelReason     String?   @map("cancel_reason")
  cancelledAt      DateTime? @map("cancelled_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([assetId])
  @@index([scheduledAt])
  @@map("zenplus_visit")
  @@schema("crm")
}

// ============================================
// SECCIÓN 2 · CRM · OLA 2 · COMMERCIAL ENGINE
// ============================================

model OpportunityAssetInterest {
  id            String         @id @default(cuid())
  opportunityId String         @map("opportunity_id")
  assetId       String         @map("asset_id") @db.Uuid
  status        InterestStatus @default(SUGGESTED)
  notes         String?
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, assetId])
  @@index([opportunityId])
  @@index([assetId])
  @@map("zenplus_opportunity_asset_interest")
  @@schema("crm")
}

model OfferThread {
  id             String      @id @default(cuid())
  opportunityId  String      @map("opportunity_id")
  assetId        String?     @map("asset_id") @db.Uuid
  status         OfferStatus @default(DRAFT)
  currentVersion Int         @default(0) @map("current_version")
  createdBy      String      @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  versions    OfferVersion[]
  reservation Reservation?

  @@index([opportunityId])
  @@index([status])
  @@map("zenplus_offer_thread")
  @@schema("crm")
}

model OfferVersion {
  id              String      @id @default(cuid())
  threadId        String      @map("thread_id")
  version         Int
  amount          Decimal     @db.Decimal(14, 2)
  currency        String      @default("USD") @db.VarChar(3)
  conditions      Json?
  status          OfferStatus
  actorId         String      @map("actor_id")
  actorRole       String      @map("actor_role") @db.VarChar(30)
  parentVersionId String?     @map("parent_version_id")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")

  thread OfferThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, version])
  @@index([threadId])
  @@map("zenplus_offer_version")
  @@schema("crm")
}

model Reservation {
  id                 String            @id @default(cuid())
  opportunityId      String            @map("opportunity_id")
  assetId            String            @map("asset_id") @db.Uuid
  offerThreadId      String?           @unique @map("offer_thread_id")
  idempotencyKey     String            @unique @map("idempotency_key")
  status             ReservationStatus @default(ACTIVE)
  expiresAt          DateTime          @map("expires_at")
  createdBy          String            @map("created_by")
  convertedAt        DateTime?         @map("converted_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  cancellationReason String?           @map("cancellation_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  opportunity Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  offerThread OfferThread? @relation(fields: [offerThreadId], references: [id])
  operation   Operation?

  @@index([assetId, status])
  @@index([opportunityId])
  @@index([expiresAt])
  @@map("zenplus_reservation")
  @@schema("crm")
}

model Operation {
  id             String          @id @default(cuid())
  reservationId  String          @unique @map("reservation_id")
  status         OperationStatus @default(BOOTSTRAPPED)
  bootstrappedAt DateTime        @default(now()) @map("bootstrapped_at")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("zenplus_operation")
  @@schema("crm")
}

// ============================================
// SECCIÓN 3 · INVENTORY
// ============================================

model Asset {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code              String            @unique @db.VarChar(50)
  name              String            @db.VarChar(150)
  description       String?
  assetType         asset_type        @map("asset_type")
  status            asset_status      @default(DRAFT)
  commercialStatus  CommercialStatus  @default(AVAILABLE) @map("commercial_status")
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  ownerPartyId      String?           @map("owner_party_id") @db.Uuid
  areaM2            Decimal           @map("area_m2") @db.Decimal(10, 2)
  currency          String            @default("USD") @db.VarChar(3)
  currentPrice      Decimal           @map("current_price") @db.Decimal(12, 2)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  asset_price_history asset_price_history[]
  asset_prices        asset_prices[]
  timeline            AssetTimeline[]
  parties             parties?              @relation(fields: [ownerPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeHold          AssetActiveHold?

  @@index([code], map: "idx_assets_code")
  @@index([ownerPartyId], map: "idx_assets_owner")
  @@index([status], map: "idx_assets_status")
  @@index([commercialStatus, currentPrice, areaM2], map: "idx_assets_commercial_search")
  @@index([publicationStatus, commercialStatus], map: "idx_assets_publication_active")
  @@map("zenplus_asset")
  @@schema("inventory")
}

model AssetTimeline {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId        String    @map("asset_id") @db.Uuid
  previousStatus String?   @map("previous_status") @db.VarChar(50)
  newStatus      String    @map("new_status") @db.VarChar(50)
  actionType     String    @default("STATUS_CHANGE") @map("action_type") @db.VarChar(50)
  details        String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assetId], map: "idx_asset_timeline_asset_id")
  @@map("zenplus_asset_timeline")
  @@schema("inventory")
}

model AssetActiveHold {
  assetId       String   @id @map("asset_id") @db.Uuid
  reservationId String   @map("reservation_id") @db.VarChar(100)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_active_hold_expires")
  @@map("zenplus_asset_active_hold")
  @@schema("inventory")
}

model InventoryDomainEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(100)
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  published     Boolean  @default(false)

  @@index([aggregateType, aggregateId], map: "idx_inventory_events_aggregate")
  @@index([occurredAt(sort: Desc)], map: "idx_inventory_events_occurred")
  @@map("zenplus_inventory_domain_events")
  @@schema("inventory")
}

model asset_price_history {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  asset_id   String    @db.Uuid
  price      Decimal   @db.Decimal(12, 2)
  currency   String    @default("USD") @db.VarChar(3)
  valid_from DateTime  @default(now()) @db.Timestamptz(6)
  valid_to   DateTime? @db.Timestamptz(6)
  changed_by String?   @db.Uuid
  reason     String?

  assets  Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parties parties? @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([asset_id], map: "idx_price_history_asset")
  @@schema("inventory")
}

model asset_prices {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id   String    @db.Uuid
  currency   String?   @default("USD") @db.VarChar(3)
  amount     Decimal   @db.Decimal(12, 2)
  is_current Boolean?  @default(true)
  valid_from DateTime? @default(now()) @db.Timestamptz(6)
  valid_to   DateTime? @db.Timestamptz(6)

  assets Asset @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("inventory")
}

model Project {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(150)
  description String?
  status      ProjectStatus @default(PLANNING)
  district    String?       @db.VarChar(100)
  city        String?       @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  units Unit[]

  @@map("zenplus_projects")
  @@schema("inventory")
}

model Unit {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  code         String     @unique @db.VarChar(50)
  name         String     @db.VarChar(150)
  unitType     String     @map("unit_type") @db.VarChar(50)
  areaM2       Decimal    @map("area_m2") @db.Decimal(10, 2)
  bedrooms     Int        @default(0)
  bathrooms    Int        @default(0)
  currentPrice Decimal    @map("current_price") @db.Decimal(12, 2)
  status       UnitStatus @default(AVAILABLE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("zenplus_unit")
  @@schema("inventory")
}

// ============================================
// SECCIÓN 4 · CORE
// ============================================

model organizations {
  party_id   String   @id @db.Uuid
  legal_name String   @db.VarChar(200)
  trade_name String?  @db.VarChar(200)
  tax_id     String   @unique @db.VarChar(20)
  email      String?  @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  parties parties @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tax_id], map: "idx_organizations_tax_id")
  @@map("zenplus_organizations")
  @@schema("core")
}

model parties {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  party_type party_type
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)

  organizations       organizations?
  persons             persons?
  asset_price_history asset_price_history[]
  assets              Asset[]

  @@map("zenplus_party_core")
  @@schema("core")
}

model persons {
  party_id   String   @id @db.Uuid
  first_name String   @db.VarChar(100)
  last_name  String   @db.VarChar(100)
  doc_type   String   @db.VarChar(20)
  doc_number String   @unique @db.VarChar(20)
  email      String   @unique @db.VarChar(150)
  phone      String?  @db.VarChar(30)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  parties parties @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doc_number], map: "idx_persons_doc_number")
  @@index([email], map: "idx_persons_email")
  @@map("zenplus_person")
  @@schema("core")
}

// ============================================
// SECCIÓN 5 · IAM
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  role      UserRole @default(ADVISOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zenplus_user")
  @@schema("iam")
}

// ============================================
// SECCIÓN 6 · ENUMS
// ============================================

// ── crm ──
enum LeadSource {
  WEB_FORM
  WHATSAPP
  PHONE
  REFERRAL
  OTHER

  @@schema("crm")
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED

  @@schema("crm")
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE

  @@schema("crm")
}

enum PartyType {
  PERSON
  ORGANIZATION

  @@schema("crm")
}

enum OpportunityStage {
  NEW
  QUALIFIED
  VISIT_SCHEDULED
  OFFER
  RESERVATION
  WON
  LOST

  @@schema("crm")
}

enum OfferStatus {
  DRAFT
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED

  @@schema("crm")
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CONVERTED

  @@schema("crm")
}

enum OperationStatus {
  BOOTSTRAPPED
  IN_PROGRESS
  CLOSED

  @@schema("crm")
}

enum InterestStatus {
  SUGGESTED
  SENT
  INTERESTED
  DISCARDED

  @@schema("crm")
}

// ── core ──
enum party_type {
  PERSON
  ORGANIZATION

  @@schema("core")
}

// ── inventory ──
enum ProjectStatus {
  PLANNING
  PRE_SALE
  CONSTRUCTION
  DELIVERED

  @@schema("inventory")
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD

  @@schema("inventory")
}

enum asset_status {
  DRAFT
  UNDER_REVIEW
  AVAILABLE
  RESERVED
  SOLD
  IN_REVIEW

  @@schema("inventory")
}

enum asset_type {
  LOT
  APARTMENT
  HOUSE
  COMMERCIAL_SPACE

  @@schema("inventory")
}

enum CommercialStatus {
  AVAILABLE
  RESERVATION_HOLD
  RESERVED
  SOLD
  UNAVAILABLE

  @@schema("inventory")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED

  @@schema("inventory")
}

// ── iam ──
enum UserRole {
  ADVISOR
  ADMIN

  @@schema("iam")
}
