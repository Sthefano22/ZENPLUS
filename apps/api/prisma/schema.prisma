generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "crm", "iam", "inventory", "finance", "operation"]
}

// ============================================
// CORE
// ============================================

model parties {
  id         String   @id
  party_type String   @default("PERSON") @db.VarChar(50)
  full_name  String?  @db.VarChar(200)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  leads                  leads[]
  commercial_commissions commercial_commissions[]
  finance_obligations    finance_obligations[]
  finance_payments       finance_payments[]
  operation_parties      operation_parties[]

  @@schema("core")
}

// ============================================
// CRM
// ============================================

model leads {
  id               String    @id
  full_name        String?   @db.VarChar(200)
  first_name       String?   @db.VarChar(100)
  last_name        String?   @db.VarChar(100)
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(50)
  source           String?   @db.VarChar(50)
  message          String?
  asset_id         String?
  party_id         String?
  assigned_to      String?   @db.VarChar(100)
  assigned_to_id   String?
  status           String    @default("NEW") @db.VarChar(50)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  sla_due_at       DateTime? @db.Timestamptz(6)
  first_contact_at DateTime? @db.Timestamptz(6)
  qualified_at     DateTime? @db.Timestamptz(6)

  parties       parties?        @relation(fields: [party_id], references: [id])
  opportunities opportunities[]
  activities    activities[]

  @@schema("crm")
}

model opportunities {
  id             String    @id
  lead_id        String
  title          String    @db.VarChar(200)
  stage          String    @default("QUALIFICATION") @db.VarChar(50)
  amount         Decimal?  @db.Decimal(12, 2)
  currency       String    @default("USD") @db.VarChar(3)
  assigned_to_id String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  closed_at      DateTime? @db.Timestamptz(6)
  close_reason   String?
  next_action    String?
  next_action_at DateTime? @db.Timestamptz(6)

  leads           leads                         @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  requirements    requirements?
  visits          visits[]
  offer_threads   offer_threads[]
  reservations    reservations[]
  asset_interests opportunity_asset_interests[]

  @@schema("crm")
}

model requirements {
  id             String   @id
  opportunity_id String   @unique
  operation_type String   @db.VarChar(20)
  asset_type     String   @db.VarChar(30)
  zones          String[] @default([])
  budget_min     Decimal? @db.Decimal(12, 2)
  budget_max     Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD") @db.VarChar(3)
  area_min       Decimal? @db.Decimal(10, 2)
  area_max       Decimal? @db.Decimal(10, 2)
  attributes     Json?
  time_horizon   String?  @db.VarChar(30)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  opportunities opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  @@schema("crm")
}

model visits {
  id                String    @id
  opportunity_id    String
  asset_id          String?
  scheduled_at      DateTime  @db.Timestamptz(6)
  status            String    @default("SCHEDULED") @db.VarChar(50)
  notes             String?
  created_by        String?
  reschedule_reason String?
  rescheduled_count Int       @default(0)
  cancel_reason     String?
  cancelled_at      DateTime? @db.Timestamptz(6)
  completed_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  outcome           String?   @db.VarChar(50)
  next_action       String?
  interest_level    Int?

  opportunities opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  @@schema("crm")
}

// ============================================
// CRM · OLA 2 · Nuevas tablas
// ============================================

model activities {
  id         String   @id @default(uuid())
  lead_id    String
  type       String   @db.VarChar(30)
  outcome    String?
  notes      String?
  created_by String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  leads leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@schema("crm")
}

model offer_threads {
  id              String   @id @default(uuid())
  opportunity_id  String
  asset_id        String?
  status          String   @default("DRAFT") @db.VarChar(30)
  current_version Int      @default(0)
  created_by      String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  opportunities  opportunities    @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)
  offer_versions offer_versions[]
  reservations   reservations?

  @@schema("crm")
}

model offer_versions {
  id                String   @id @default(uuid())
  thread_id         String
  version           Int
  amount            Decimal  @db.Decimal(14, 2)
  currency          String   @default("USD") @db.VarChar(3)
  conditions        Json?
  status            String   @db.VarChar(30)
  actor_id          String
  actor_role        String   @db.VarChar(30)
  parent_version_id String?
  notes             String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  offer_threads offer_threads @relation(fields: [thread_id], references: [id], onDelete: Cascade)

  @@unique([thread_id, version])
  @@schema("crm")
}

model reservations {
  id                  String    @id @default(uuid())
  opportunity_id      String
  asset_id            String
  offer_thread_id     String?   @unique
  idempotency_key     String    @unique @db.VarChar(100)
  status              String    @default("ACTIVE") @db.VarChar(30)
  expires_at          DateTime  @db.Timestamptz(6)
  created_by          String
  converted_at        DateTime? @db.Timestamptz(6)
  cancelled_at        DateTime? @db.Timestamptz(6)
  cancellation_reason String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @updatedAt @db.Timestamptz(6)

  opportunities opportunities  @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)
  offer_threads offer_threads? @relation(fields: [offer_thread_id], references: [id])

  @@schema("crm")
}

// ============================================
// IAM
// ============================================

model users {
  id            String   @id
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.VarChar(255)
  first_name    String   @db.VarChar(100)
  last_name     String?  @db.VarChar(100)
  role          String   @default("USER") @db.VarChar(50)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  @@schema("iam")
}

// ============================================
// INVENTORY
// ============================================

model assets {
  id                 String   @id
  project_id         String?
  owner_party_id     String?
  code               String   @unique @db.VarChar(50)
  title              String   @db.VarChar(200)
  type               String   @db.VarChar(50)
  status             String   @default("AVAILABLE") @db.VarChar(50)
  price              Decimal  @db.Decimal(12, 2)
  currency           String   @default("USD") @db.VarChar(3)
  area               Decimal? @db.Decimal(10, 2)
  details            Json?
  commercial_status  String   @default("AVAILABLE") @db.VarChar(50)
  publication_status String   @default("DRAFT") @db.VarChar(50)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  projects    projects?           @relation(fields: [project_id], references: [id])
  units       units[]
  active_hold asset_active_holds?
  timelines   asset_timelines[]

  @@schema("inventory")
}

model projects {
  id          String   @id
  code        String?  @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?
  location    String?  @db.VarChar(255)
  district    String?  @db.VarChar(100)
  city        String?  @db.VarChar(100)
  status      String   @default("ACTIVE") @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  assets assets[]
  units  units[]

  @@schema("inventory")
}

model units {
  id            String   @id
  asset_id      String?
  project_id    String?
  code          String   @db.VarChar(50)
  name          String?  @db.VarChar(150)
  unit_type     String?  @db.VarChar(50)
  floor         Int?
  area_m2       Decimal? @db.Decimal(10, 2)
  bedrooms      Int      @default(0)
  bathrooms     Int      @default(0)
  price         Decimal? @db.Decimal(12, 2)
  current_price Decimal? @db.Decimal(12, 2)
  status        String   @default("AVAILABLE") @db.VarChar(50)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  assets   assets?   @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  projects projects? @relation(fields: [project_id], references: [id])

  @@schema("inventory")
}

// ============================================
// INVENTORY · OLA 2 · Nuevas tablas
// ============================================

model asset_timelines {
  id              String   @id @default(uuid())
  asset_id        String
  previous_status String?  @db.VarChar(50)
  new_status      String   @db.VarChar(50)
  action_type     String   @default("STATUS_CHANGE") @db.VarChar(50)
  details         String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  assets assets @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@schema("inventory")
}

model asset_active_holds {
  asset_id       String   @id
  reservation_id String   @db.VarChar(100)
  expires_at     DateTime @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  assets assets @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@schema("inventory")
}

model inventory_domain_events {
  id             String   @id @default(uuid())
  event_type     String   @db.VarChar(100)
  aggregate_type String   @db.VarChar(50)
  aggregate_id   String
  payload        Json
  occurred_at    DateTime @default(now()) @db.Timestamptz(6)
  published      Boolean  @default(false)

  @@schema("inventory")
}

// ============================================
// FINANCE
// ============================================

model commercial_commissions {
  id               String   @id
  operation_id     String
  advisor_party_id String
  role             String   @default("ADVISOR") @db.VarChar(50)
  basis_amount     Decimal  @db.Decimal(12, 2)
  rate             Decimal? @db.Decimal(5, 4)
  amount           Decimal? @db.Decimal(12, 2)
  status           String   @default("CALCULATED") @db.VarChar(30)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  parties parties @relation(fields: [advisor_party_id], references: [id])

  @@schema("finance")
}

model finance_obligations {
  id              String   @id
  operation_id    String
  debtor_party_id String
  title           String   @db.VarChar(200)
  total_amount    Decimal  @db.Decimal(12, 2)
  paid_amount     Decimal  @default(0) @db.Decimal(12, 2)
  due_date        DateTime @db.Timestamptz(6)
  status          String   @default("PENDING") @db.VarChar(30)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  parties parties @relation(fields: [debtor_party_id], references: [id])

  @@schema("finance")
}

model finance_payments {
  id               String   @id
  operation_id     String?
  obligation_id    String?
  payer_party_id   String?
  amount           Decimal  @db.Decimal(12, 2)
  allocated_amount Decimal  @default(0) @db.Decimal(12, 2)
  payment_method   String?  @db.VarChar(50)
  reference_code   String?  @db.VarChar(100)
  payment_date     DateTime @default(now()) @db.Timestamptz(6)
  status           String   @default("SUBMITTED") @db.VarChar(30)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  parties parties? @relation(fields: [payer_party_id], references: [id])

  @@schema("finance")
}

// ============================================
// OPERATION
// ============================================

model operations {
  id                    String   @id @default(uuid()) @db.Uuid
  source_reservation_id String?  @unique @map("source_reservation_id")
  opportunity_id        String?  @map("opportunity_id") @db.Uuid
  asset_id              String?  @map("asset_id") @db.Uuid
  status                String   @default("OPEN") @db.VarChar(40)
  reservation_snapshot  Json?    @map("reservation_snapshot")
  created_by            String?  @map("created_by")
  created_at            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Campos del schema original de Beta (para no romper nada)
  code           String?        @db.VarChar(50)
  operation_type OperationType  @default(SALE)
  stage          OperationStage @default(RESERVATION_HANDOFF)
  agreed_amount  Decimal        @default(0) @db.Decimal(14, 2)
  currency       String         @default("USD") @db.VarChar(3)
  reservation_id String?        @db.Uuid
  notes          String?

  // Relaciones
  operation_assets         operation_assets[]
  operation_parties        operation_parties[]
  operation_status_history operation_status_history[]
  operation_participants   operation_participants[]
  reservation_handoffs     reservation_handoffs[]

  @@schema("crm")
}

model operation_assets {
  id           String    @id @default(uuid()) @db.Uuid
  operation_id String    @db.Uuid
  asset_id     String    @db.Uuid
  unit_id      String?   @db.Uuid
  role         AssetRole @default(PRIMARY)
  agreed_price Decimal?  @db.Decimal(14, 2)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  operations operations @relation(fields: [operation_id], references: [id], onDelete: Cascade)

  @@schema("operation")
}

model operation_parties {
  id           String    @id @default(uuid()) @db.Uuid
  operation_id String    @db.Uuid
  party_id     String
  role         PartyRole
  is_primary   Boolean   @default(false)
  notes        String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  operations operations @relation(fields: [operation_id], references: [id], onDelete: Cascade)
  parties    parties    @relation(fields: [party_id], references: [id])

  @@schema("operation")
}

model operation_status_history {
  id           String   @id @default(uuid()) @db.Uuid
  operation_id String   @map("operation_id") @db.Uuid
  from_status  String?  @map("from_status") @db.VarChar(40)
  to_status    String   @map("to_status") @db.VarChar(40)
  changed_by   String?  @map("changed_by")
  reason       String?
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relación con operations
  operation operations @relation(fields: [operation_id], references: [id], onDelete: Cascade)

  @@index([operation_id])
  @@schema("crm")
}

model operation_participants {
  id           String   @id @default(uuid()) @db.Uuid
  operation_id String   @map("operation_id") @db.Uuid
  user_id      String   @map("user_id") // ID del usuario (Alpha/IAM)
  role         String   @db.VarChar(50) // ADVISOR, CLIENT, OWNER, etc.
  created_at   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relación con operations
  operation operations @relation(fields: [operation_id], references: [id], onDelete: Cascade)

  @@unique([operation_id, user_id, role])
  @@schema("crm")
}

model reservation_handoffs {
  id             String   @id @default(uuid()) @db.Uuid
  operation_id   String   @db.Uuid
  reservation_id String   @db.Uuid
  snapshot_data  Json
  handed_off_by  String?  @db.VarChar(100)
  handed_off_at  DateTime @default(now()) @db.Timestamptz(6)

  operations operations @relation(fields: [operation_id], references: [id], onDelete: Cascade)

  @@schema("operation")
}

model opportunity_asset_interests {
  id             String   @id @default(uuid()) @db.Uuid
  opportunity_id String
  asset_id       String
  status         String   @default("SUGGESTED") @db.VarChar(30)
  notes          String?
  created_by     String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  opportunities opportunities @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  @@unique([opportunity_id, asset_id])
  @@schema("crm")
}

// ============================================
// SECCIÓN 6 · ENUMS
// ============================================

// ── crm ──
enum LeadSource {
  WEB_FORM
  WHATSAPP
  PHONE
  REFERRAL
  OTHER

  @@schema("crm")
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED

  @@schema("crm")
}

enum ActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE

  @@schema("crm")
}

enum PartyType {
  PERSON
  ORGANIZATION

  @@schema("crm")
}

enum OpportunityStage {
  NEW
  QUALIFIED
  VISIT_SCHEDULED
  OFFER
  RESERVATION
  WON
  LOST

  @@schema("crm")
}

enum OfferStatus {
  DRAFT
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED

  @@schema("crm")
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CONVERTED

  @@schema("crm")
}

enum OperationStatus {
  BOOTSTRAPPED
  IN_PROGRESS
  CLOSED

  @@schema("crm")
}

enum InterestStatus {
  SUGGESTED
  SENT
  INTERESTED
  DISCARDED

  @@schema("crm")
}

// ── core ──
enum party_type {
  PERSON
  ORGANIZATION

  @@schema("core")
}

// ── inventory ──
enum ProjectStatus {
  PLANNING
  PRE_SALE
  CONSTRUCTION
  DELIVERED

  @@schema("inventory")
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  SOLD

  @@schema("inventory")
}

enum asset_status {
  DRAFT
  UNDER_REVIEW
  AVAILABLE
  RESERVED
  SOLD
  IN_REVIEW

  @@schema("inventory")
}

enum asset_type {
  LOT
  APARTMENT
  HOUSE
  COMMERCIAL_SPACE

  @@schema("inventory")
}

enum CommercialStatus {
  AVAILABLE
  RESERVATION_HOLD
  RESERVED
  SOLD
  UNAVAILABLE

  @@schema("inventory")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED

  @@schema("inventory")
}

// ── iam ──
enum UserRole {
  ADVISOR
  ADMIN

  @@schema("iam")
}

enum PartyRole {
  BUYER
  SELLER
  LESSOR
  TENANT
  ADVISOR
  LEGAL_REP

  @@schema("operation")
}

enum AssetRole {
  PRIMARY
  PARKING
  STORAGE
  SECONDARY

  @@schema("operation")
}

enum OperationType {
  SALE
  RENT

  @@schema("operation")
}

enum OperationStage {
  DRAFT
  RESERVATION_HANDOFF
  DOCUMENT_COLLECTION
  CONTRACT_PENDING
  SIGNING
  SETTLED
  CANCELLED

  @@schema("operation")
}
